{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tuktuk-io",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tuktukio.anjula.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://tuktukio.anjula.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "LOBBY_RATE_LIMITER",
      "namespace_id": "184729",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/rooms/*"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TukTukRoom", "TukTukLobby"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "TukTukRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "TukTukLobby"
      }
    ]
  }
}
